APP_NAME=LatsMarbls
APP_ENV=local
APP_KEY=
APP_API_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Payroll Configuration
PAYROLL_WORKING_DAYS_PER_MONTH=22
PAYROLL_WORK_HOURS_PER_DAY=8
PAYROLL_MONEY_PRECISION=2
PAYROLL_HOURLY_RATE_MULTIPLIER=1.25
PAYROLL_LATE_DEDUCTION_PER_MINUTE=0.50
PAYROLL_PAY_PERIODS_PER_MONTH=2
PAYROLL_EXCLUDE_HOLIDAYS_FROM_EXPECTED=true
PAYROLL_REGULAR_HOLIDAY_MULTIPLIER=1.5
PAYROLL_SPECIAL_HOLIDAY_MULTIPLIER=2
PAYROLL_PRORATE_CONTRIBUTIONS=true
PAYROLL_PAGIBIG_THRESHOLD_SALARY=1500
PAYROLL_PAGIBIG_RATE_BELOW_THRESHOLD=0.01
PAYROLL_PAGIBIG_RATE_AT_OR_ABOVE_THRESHOLD=0.02
PAYROLL_PAGIBIG_MAX_SALARY_BASE=5000
PAYROLL_PHILHEALTH_PREMIUM_RATE=0.05
PAYROLL_PHILHEALTH_EMPLOYEE_SHARE=0.50
PAYROLL_PHILHEALTH_MIN_SALARY_BASE=10000
PAYROLL_PHILHEALTH_MAX_SALARY_BASE=100000

VITE_APP_NAME="${APP_NAME}"
