{
  "info": {
    "name": "HRIS API Connectivity and Auth Tests",
    "description": "Use these requests to isolate Hoppscotch network issues vs API key/auth issues.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "https://hris.test"
    },
    {
      "key": "API_KEY",
      "value": "Ohsv9ZHTnttZ3jEm3M46U3eFDKheuUc0"
    }
  ],
  "item": [
    {
      "name": "1) App Connectivity Check (/up)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/up",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "up"
          ]
        },
        "description": "If this fails with network error, issue is DNS/host/SSL/proxy, not API key middleware."
      }
    },
    {
      "name": "2) API Health (Valid X-Api-Key)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{API_KEY}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/v1/health",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "api",
            "v1",
            "health"
          ]
        },
        "description": "Expected: 200 with success JSON."
      }
    },
    {
      "name": "3) API Health (Missing Key)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/v1/health",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "api",
            "v1",
            "health"
          ]
        },
        "description": "Expected: 401 Unauthorized from valid.api.key middleware."
      }
    },
    {
      "name": "4) API Health (Invalid Key)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "INVALID_TEST_KEY"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/v1/health",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "api",
            "v1",
            "health"
          ]
        },
        "description": "Expected: 401 Unauthorized."
      }
    },
    {
      "name": "5) API Health (api_key Query Param)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/v1/health?api_key={{API_KEY}}",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "api",
            "v1",
            "health"
          ],
          "query": [
            {
              "key": "api_key",
              "value": "{{API_KEY}}"
            }
          ]
        },
        "description": "Expected: 200. Confirms query-param fallback works."
      }
    },
    {
      "name": "6) Employees Index (Valid Key)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{API_KEY}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/v1/employees",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "api",
            "v1",
            "employees"
          ]
        },
        "description": "Expected: 200 and paginated employee data."
      }
    }
  ]
}
